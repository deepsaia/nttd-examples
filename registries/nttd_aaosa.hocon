# Shared delegation instructions, included by every nttd network.
#
# Lifted from the neuro-san AAOSA pattern: an agent asked an inquiry first decides whether
# it is the right one to answer, then asks its down-chain agents what they need, then
# delegates, then compiles. Kept in one file so five networks cannot drift apart.

# Anthropic, because the judgement here is about trade-offs rather than recall: which of
# three viable corridors pays, whether to expand or consolidate, which problem matters now.
# Needs ANTHROPIC_API_KEY in the environment of the neuro-san SERVER, not this repository.
# Swap the model name for "claude-opus" on a hard map, or "claude-haiku" to run cheaply.
nttd_llm_config = {
    "model_name": "claude-sonnet"
}

aaosa_call = {
    description = "Depending on the mode of the inquiry, use this tool to either determine the requirements to fulfill it, or fulfill it."
    parameters = {
        type = "object"
        properties = {
            inquiry = { type = "string", description = "The inquiry" }
            mode = {
                type = "string"
                description = """
Use 'Determine' to ask the agent what is needed to fulfil the inquiry.
Use 'Fulfill' to ask the agent to fulfil the inquiry once requirements are known.
"""
            }
        }
        required = ["inquiry", "mode"]
    }
}

aaosa_instructions = """
When you receive an inquiry:
0. If you are clearly not the right agent for this inquiry, say so and stop.
1. Call your down-chain agents to determine which of them is responsible for it.
2. Ask those agents what they need in order to handle their part.
3. Delegate the inquiry and the gathered requirements to them.
4. Compile their responses into one answer.
"""

# The rule that every network shares, because every mode has lost a run to breaking it.
nttd_ground_rules = """
Three things are true in every transport mode here, and each one cost a whole run to learn:

1. A build action returning success is NOT a working route. Nothing buys a vehicle until
   verify_reachable says a vehicle can get from where it will start to where it must go.
2. A station outside its own catchment earns nothing, however well sited it looks. Coverage
   is small: a commuter airport reaches 4 tiles, and a rail platform beside a town of 2,468
   collected 12 passengers.
3. The score is mostly cargo delivered. It is 400 of the 1,000 points, four times any other
   component, so a decision that moves more freight beats one that looks tidier.

Never guess a coordinate, a station id or an engine id. Every one of them comes from a tool.
"""
