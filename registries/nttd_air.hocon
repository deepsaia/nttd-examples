include "registries/nttd_aaosa.hocon"

llm_config = ${nttd_llm_config}

metadata {
    description = "Plays one nttd session by air. Aircraft need no infrastructure between their endpoints, which removes the class of failure that stops rail and water, at the cost of expensive vehicles and airports."
    tags = ["nttd", "air"]
    sample_queries = [
        "Take the next step in this session.",
        "What should I build first?",
        "Something is wrong: nothing is being delivered.",
    ]
}

tools = [
    # The front man. It talks to the runner and holds no tools of its own beyond its
    # down-chain agents: it cannot use a coded tool class, by neuro-san's rule.
    {
        name = "AirNetwork"
        function {
            description = """
Plays one step of an nttd session using aircraft: decides what to do now and does it.
"""
        }
        instructions = """
You run one transport company for a benchmark session, and you play it to the end.

Each turn:
1. Ask Position where you stand. It reports what is broken and what was refused recently.
2. If anything is broken, fix it before building. A vehicle that is not earning is money
   already spent, and repairing it is cheaper than replacing it.
3. Otherwise ask Expansion to grow.
4. Let time pass so the world can show you whether that worked.

Never repeat something that was just refused. If a tool says why it refused, that reason is
the thing to act on; doing the same call again gets the same answer.

Keep going until the session ends. A run is a whole game year.
""" ${nttd_ground_rules} ${aaosa_instructions}
        tools = ["Position", "Expansion", "fix_problems", "let_time_pass"]
    }

    {
        name = "Position"
        function = ${aaosa_call}{
            description = "Where the company stands right now, and what is going wrong."
        }
        instructions = """
Call read_position and report what it returns. Do no arithmetic of your own: every figure
you need is already computed, and a number you work out yourself is a number nothing checks.

Say plainly which problems matter most. A vehicle that is lost or not moving outranks a
station that is merely busy.
"""
        tools = ["read_position"]
    }

    {
        name = "Expansion"
        function = ${aaosa_call}{
            description = "Chooses what to build next and builds it."
        }
        instructions = """
You grow the company, in this order, and skipping a step wastes the money spent on the ones
before it:

1. **borrow** what the next build costs. A company opens with 100,000 and a route costs more.
2. **rank_sites** for your mode. Everything it returns is already viable; prefer the biggest
   populations and the longest legs between them.
3. **build_route** with two of those sites. It builds, verifies, and remembers the route.
4. **buy_and_dispatch** once it reports ready.

To grow an existing route rather than open a new one, call buy_and_dispatch with the town it
serves. A route with cargo piling up wants more vehicles; a route already moving what it
collects wants a new corridor instead.

The tools carry the rules and will refuse with a reason. Read the reason.
""" ${aaosa_instructions}
        tools = ["rank_sites", "borrow", "build_route", "buy_and_dispatch", "verify_reachable"]
    }

    {
        name = "let_time_pass"
        function = {
            description = "Lets the game run for a number of days and reports what changed."
            parameters = {
                type = "object"
                properties = {
                    days = {
                        type = "integer"
                        description = "How many game days to let pass before looking again."
                    }
                }
                required = ["days"]
            }
        }
        class = "let_time_pass.LetTimePass"
    }
    {
        name = "build_route"
        function = {
            description = "Builds the infrastructure a route needs and verifies it will carry."
            parameters = {
                type = "object"
                properties = {
                    mode = { type = "string", description = "air, water, road or rail" }
                    from_site = {
                        type = "object"
                        description = "One end, as rank_sites returned it"
                    }
                    to_site = {
                        type = "object"
                        description = "The other end, as rank_sites returned it"
                    }
                }
                required = ["mode", "from_site", "to_site"]
            }
        }
        class = "build_route.BuildRoute"
    }
    {
        name = "borrow"
        function = {
            description = "Sets the company loan, so there is money to build with."
            parameters = {
                type = "object"
                properties = {
                    amount = { type = "integer", description = "The loan to hold, in pounds" }
                }
                required = ["amount"]
            }
        }
        class = "borrow.Borrow"
    }
    {
        name = "read_position"
        function = {
            description = "Money, fleet, stations, days left, and every problem worth acting on."
        }
        class = "read_position.ReadPosition"
    }
    {
        name = "rank_sites"
        function = {
            description = "Places worth building, best first, with the unviable ones already removed."
            parameters = {
                type = "object"
                properties = {
                    mode = { type = "string", description = "air, road, water or rail" }
                    limit = { type = "integer", description = "How many to return" }
                }
                required = ["mode"]
            }
        }
        class = "rank_sites.RankSites"
    }
    {
        name = "buy_and_dispatch"
        function = {
            description = "Buys vehicles for a route that exists and leaves them running."
            parameters = {
                type = "object"
                properties = {
                    count = { type = "integer", description = "How many to buy, 1 to 4" }
                    town = {
                        type = "string"
                        description = "Add to the route serving this town. Omit for the newest."
                    }
                }
                required = ["count"]
            }
        }
        class = "buy_and_dispatch.BuyAndDispatch"
    }
    {
        name = "fix_problems"
        function = {
            description = "Repairs every vehicle that is not earning: no orders, stopped, or lost."
        }
        class = "fix_problems.FixProblems"
    }
    {
        name = "verify_reachable"
        function = {
            description = "Whether a vehicle starting at one point can actually reach another."
            parameters = {
                type = "object"
                properties = {
                    from_x = { type = "integer" }
                    from_y = { type = "integer" }
                    to_x = { type = "integer" }
                    to_y = { type = "integer" }
                    transport_type = { type = "string", description = "road, rail or water" }
                }
                required = ["from_x", "from_y", "to_x", "to_y", "transport_type"]
            }
        }
        class = "verify_reachable.VerifyReachable"
    }
]
