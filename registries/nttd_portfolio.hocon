include "registries/nttd_aaosa.hocon"

llm_config = ${nttd_llm_config}

metadata {
    description = "Plays one nttd session across every mode, allocating capital to whichever reaches revenue soonest."
    tags = ["nttd", "combined"]
    sample_queries = [
        "Take the next step in this session.",
        "What should I build first?",
        "Something is wrong: nothing is being delivered.",
    ]
}

tools = [
    # The front man. It talks to the runner and holds no tools of its own beyond its
    # down-chain agents: it cannot use a coded tool class, by neuro-san's rule.
    {
        name = "PortfolioNetwork"
        function {
            description = """
Plays one step of an nttd session, choosing which transport mode to spend on.
"""
        }
        instructions = """
You run one transport company for a single step, and you choose which mode to spend on.

Sequence by how quickly a mode reaches revenue, because the first earnings fund everything
after them. On the evidence that ordering is road first, then air, then water, and rail
last, which is the opposite of what an experienced OpenTTD player would assume: road is
cheapest to start because towns already have roads, and air earns most per vehicle because
aircraft need nothing built between their endpoints.

Do not spread thin. One mode carrying freight beats three half-built.

Work in this order and do not skip:
1. Ask Position where the company stands. Never assume, and never carry a number over from
   a previous step.

   This is also how you find out what your LAST turn actually achieved. An action reporting
   success only means the command was accepted; whether it worked shows up here, one turn
   later, as a vehicle that is moving or one that is sitting still. Read the problems list
   against what you did last time before you decide anything new.
2. If Position reports problems, fix those before building anything new. A vehicle that is
   lost, has no orders or is not moving is money already spent that is earning nothing, and
   it is always cheaper to fix than to replace.
3. Otherwise ask Expansion what to build next.

Stop building and hold cash when Position says there are fewer days left than a vehicle
needs to pay for itself.
You also control TIME, and it is one of your real decisions.

Submitting actions already advances the world by one day: nttd executes what you sent and
then steps forward. So building something costs a day, and doing nothing costs nothing until
you ask for it.

Call let_time_pass when you have committed to something and need the world to run before
you can judge it. How long is your call, and it depends on what you just did:
  - about 10 days to see whether a vehicle actually left its depot,
  - about 30 to see a route start earning,
  - about 90 to see whether a network pays or is saturated.

It reports what changed, so use that rather than asking again immediately. When it says the
session has ended, stop: the run is over and nothing further can be built or bought.

Keep going until then. A run is a whole game year and you have many decisions to make in
it; do not stop after building one thing.

""" ${nttd_ground_rules} ${aaosa_instructions}
        tools = ["Position", "Expansion", "let_time_pass"]
    }

    {
        name = "Position"
        function = ${aaosa_call}{
            description = "Where the company stands right now, and what is going wrong."
        }
        instructions = """
Call read_position and report what it returns. Do no arithmetic of your own: every figure
you need is already computed, and a number you work out yourself is a number nothing checks.

Say plainly which problems matter most. A vehicle that is lost or not moving outranks a
station that is merely busy.
"""
        tools = ["read_position"]
    }

    {
        name = "Expansion"
        function = ${aaosa_call}{
            description = "Chooses what to build next and builds it."
        }
        instructions = """
You decide where this company grows next, and you commit the money.

The order matters and skipping a step wastes the money spent on the ones before it:

1. **Money first.** A company opens with 100,000, and two airports plus the aircraft to fly
   between them cost several times that. Call borrow before building, for roughly what you
   are about to spend. Borrowing more than 250,000 forfeits part of the score, so borrow
   against something you are about to build rather than to hold cash.
2. **Sites.** Call rank_sites with the mode you are playing. Every site it returns is inside its own
   airport's coverage; sites that are not never appear. Prefer the largest populations and
   the longest legs between them: a big plane on a 205 tile leg has earned six times what
   small planes on 35 tile hops earned.
3. **Build.** Call build_route with the two sites. NOTHING can be bought before this: an
   aircraft with nowhere to land is money spent on an ornament.
4. **Then buy.** Call buy_and_dispatch once per aircraft, ordering it between the two
   stations build_route reported.

build_route joins the two ends and then proves a vehicle can travel between them. If it
answers ready false, read why and fix THAT: a corridor that did not join names the tile it
failed on, and a stop reachable in one tile is connected to nothing. Do not buy a vehicle
for a route that is not ready, and do not build the same route again hoping for a different
answer.
""" ${aaosa_instructions}
        tools = ["rank_sites", "borrow", "build_route", "buy_and_dispatch", "verify_reachable"]
    }

    {
        name = "let_time_pass"
        function = {
            description = "Lets the game run for a number of days and reports what changed."
            parameters = {
                type = "object"
                properties = {
                    days = {
                        type = "integer"
                        description = "How many game days to let pass before looking again."
                    }
                }
                required = ["days"]
            }
        }
        class = "let_time_pass.LetTimePass"
    }
    {
        name = "build_route"
        function = {
            description = "Builds the infrastructure a route needs and verifies it will carry."
            parameters = {
                type = "object"
                properties = {
                    mode = { type = "string", description = "air, water, road or rail" }
                    from_site = {
                        type = "object"
                        description = "One end, as rank_sites returned it"
                    }
                    to_site = {
                        type = "object"
                        description = "The other end, as rank_sites returned it"
                    }
                }
                required = ["mode", "from_site", "to_site"]
            }
        }
        class = "build_route.BuildRoute"
    }
    {
        name = "borrow"
        function = {
            description = "Sets the company loan, so there is money to build with."
            parameters = {
                type = "object"
                properties = {
                    amount = { type = "integer", description = "The loan to hold, in pounds" }
                }
                required = ["amount"]
            }
        }
        class = "borrow.Borrow"
    }
    {
        name = "read_position"
        function = {
            description = "Money, fleet, stations, days left, and every problem worth acting on."
        }
        class = "read_position.ReadPosition"
    }
    {
        name = "rank_sites"
        function = {
            description = "Places worth building, best first, with the unviable ones already removed."
            parameters = {
                type = "object"
                properties = {
                    mode = { type = "string", description = "air, road, water or rail" }
                    limit = { type = "integer", description = "How many to return" }
                }
                required = ["mode"]
            }
        }
        class = "rank_sites.RankSites"
    }
    {
        name = "buy_and_dispatch"
        function = {
            description = "Buys one vehicle, orders it between stations, and leaves it running."
            parameters = {
                type = "object"
                properties = {
                    engine_id = { type = "integer", description = "Which engine to buy" }
                    depot_x = { type = "integer", description = "Depot or hangar x" }
                    depot_y = { type = "integer", description = "Depot or hangar y" }
                    station_ids = {
                        type = "array"
                        items = { type = "integer" }
                        description = "The stations to order it between, in order"
                    }
                }
                required = ["engine_id", "depot_x", "depot_y", "station_ids"]
            }
        }
        class = "buy_and_dispatch.BuyAndDispatch"
    }
    {
        name = "verify_reachable"
        function = {
            description = "Whether a vehicle starting at one point can actually reach another."
            parameters = {
                type = "object"
                properties = {
                    from_x = { type = "integer" }
                    from_y = { type = "integer" }
                    to_x = { type = "integer" }
                    to_y = { type = "integer" }
                    transport_type = { type = "string", description = "road, rail or water" }
                }
                required = ["from_x", "from_y", "to_x", "to_y", "transport_type"]
            }
        }
        class = "verify_reachable.VerifyReachable"
    }
]
