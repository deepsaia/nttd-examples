# Copy to .env and fill in. neuro-san-studio's `ns run` loads a project-root .env before it
# starts the server, so everything here reaches the agent networks and their coded tools
# without being exported by hand in each terminal. The interactive runner reads the same file.
#
# Only ANTHROPIC_API_KEY has no usable default. Everything below it is already set to what
# this repository expects, and is written out so it can be changed rather than guessed at.

# --- the model the networks reason with -------------------------------------------------
# The workers ask for "claude-sonnet" and the strategist for "claude-opus", both set in
# agents/neuro_san/registries/ns_common.hocon and ns_air_agent.hocon beside it. Swap them there, not here.
ANTHROPIC_API_KEY=

# --- where the agent networks and their tools live --------------------------------------
# Read by neuro-san at startup. The registries sit beside the tools they name, under
# agents/neuro_san/, because a network IS its registry plus its coded tools and keeping
# them in one place is what makes a network something you can read in one directory.
# AGENT_TOOL_PATH is where a registry's
# `class = "ns.read_situation.ReadSituation"` is resolved from.
AGENT_MANIFEST_FILE=agents/neuro_san/registries/manifest.hocon
AGENT_TOOL_PATH=agents/neuro_san/coded_tools

# Resolve that class reference ONLY from AGENT_TOOL_PATH. Without this, it resolves as a
# fully qualified import from anywhere on PYTHONPATH, so a registry could name any importable
# class in the environment and neuro-san would load it. The networks here only ever reference
# their own tools, so restricting it costs nothing and closes that door.
AGENT_TOOL_PATH_ONLY=true

# --- the neuro-san server ---------------------------------------------------------------
# Where `ns run` listens, and what the runner connects to. These are neuro-san-studio's own
# defaults, repeated here because the runner has to agree with the server about them.
NEURO_SAN_SERVER_HOST=localhost
NEURO_SAN_SERVER_CONNECTION=http
NEURO_SAN_SERVER_HTTP_PORT=8080

# The NSFlow web UI, which `ns run` also starts. Useful for watching a turn unfold: every
# tool call and its arguments appear there, which is the quickest way to see why a network
# chose what it chose. Set NSFLOW_HOST to 0.0.0.0 to reach it from another machine.
NSFLOW_HOST=localhost
NSFLOW_PORT=4173

# Where the server writes what the agents are thinking, and how it formats its own logs.
THINKING_FILE=/tmp/agent_thinking.txt
AGENT_SERVICE_LOG_JSON=logging.hocon

# --- the game -----------------------------------------------------------------------------
# Where `nttd server` is listening. The coded tools call it. The session id and participant
# token are deliberately NOT here: they change every run, the runner prompts for them, and
# they travel as sly_data so a token never lands in a chat payload or a log line.
NTTD_API_URL=http://127.0.0.1:8000

# A stepped session blocks the caller until the game has advanced, and advancing many days
# can take a while, so this is generous on purpose.
NTTD_TIMEOUT_SECONDS=900
