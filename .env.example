# Copy to .env and fill in. `ns run` loads a project-root .env before starting the server,
# so everything here reaches the agent networks and their coded tools without being exported
# by hand in each terminal.

# --- the model the networks reason with -------------------------------------------------
# The networks ask for "claude-sonnet". Swap the model in registries/nttd_aaosa.hocon for
# claude-opus on a hard map, or claude-haiku to run cheaply.
ANTHROPIC_API_KEY=

# --- where the agent networks and their tools live --------------------------------------
# Both are read by neuro-san when it starts. AGENT_TOOL_PATH is where a HOCON's
# `class = "read_position.ReadPosition"` is resolved from.
AGENT_MANIFEST_FILE=registries/manifest.hocon
AGENT_TOOL_PATH=agents/neuro_san/coded_tools

# Resolve a HOCON's `class = "read_position.ReadPosition"` ONLY from AGENT_TOOL_PATH.
# Without this, a class reference resolves as a fully-qualified import from anywhere on
# PYTHONPATH, so an agent network file could name any importable class in the environment
# and neuro-san would load it. The networks here only ever reference their own tools, so
# restricting it costs nothing and closes that door.
AGENT_TOOL_PATH_ONLY=true

# --- the game ---------------------------------------------------------------------------
# Where `nttd server` is listening. The coded tools call it; the session id and participant
# token are NOT here, because they change per run and are passed as sly_data instead.
NTTD_API_URL=http://127.0.0.1:8000
NTTD_TIMEOUT_SECONDS=900
